# syntax=docker/dockerfile:1.7

# Single-container "plug-n-play" image for single-node deployments.
# Includes PostgreSQL, awg-api with embedded worker, amneziawg-tools,
# and amneziawg-go userspace fallback.
#
# Run:
#   docker run --rm -it \
#     --cap-add=NET_ADMIN --device=/dev/net/tun \
#     -p 127.0.0.1:18080:18080 -p 51820:51820/udp \
#     -e JWT_SECRET=change-me-in-production \
#     -e BOOTSTRAP_NODE_ENDPOINT=1.2.3.4 \
#     awg-rest/all-in-one

# ---- Go builder --------------------------------------------------------------
FROM golang:1.26.2-alpine AS go-builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev
ENV CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH}
RUN go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/awg-api ./cmd/awg-api

# ---- amneziawg-tools builder -------------------------------------------------
FROM alpine:3.23 AS awg-tools-builder
ARG AMNEZIAWG_TOOLS_TAG=v1.0.20260223
ARG AMNEZIAWG_TOOLS_COMMIT=5d6179a6d0842e98dfb349c28cf1bd8e4b9d1079
RUN apk add --no-cache build-base git linux-headers
RUN git clone --depth 1 --branch "${AMNEZIAWG_TOOLS_TAG}" https://github.com/amnezia-vpn/amneziawg-tools.git /src/amneziawg-tools && \
    cd /src/amneziawg-tools && \
    test "$(git rev-parse HEAD)" = "${AMNEZIAWG_TOOLS_COMMIT}" && \
    make -C src && \
    mkdir -p /out && \
    cp src/wg /out/awg && \
    cp src/wg-quick/linux.bash /out/awg-quick && \
    chmod 0755 /out/awg /out/awg-quick

# ---- amneziawg-go builder ----------------------------------------------------
FROM golang:1.26.2-alpine AS awg-go-builder
ARG AMNEZIAWG_GO_TAG=v0.2.17
ARG AMNEZIAWG_GO_COMMIT=12a012205e3c444be02aba91a840455f74c127e1
RUN apk add --no-cache git make
RUN git clone --depth 1 --branch "${AMNEZIAWG_GO_TAG}" https://github.com/amnezia-vpn/amneziawg-go.git /src/amneziawg-go && \
    cd /src/amneziawg-go && \
    test "$(git rev-parse HEAD)" = "${AMNEZIAWG_GO_COMMIT}" && \
    make && \
    mkdir -p /out && \
    cp amneziawg-go /out/amneziawg-go
RUN chmod 0755 /out/amneziawg-go && ln -s amneziawg-go /out/wireguard-go

# ---- final -------------------------------------------------------------------
FROM postgres:17-alpine AS awg-rest-all-in-one
RUN apk add --no-cache bash iproute2 iptables nftables openresolv ca-certificates su-exec

# AmneziaWG tooling
COPY --from=awg-tools-builder /out/awg /usr/local/bin/awg
COPY --from=awg-tools-builder /out/awg-quick /usr/local/bin/awg-quick
COPY --from=awg-go-builder /out/amneziawg-go /usr/local/bin/amneziawg-go
COPY --from=awg-go-builder /out/wireguard-go /usr/local/bin/wireguard-go

# Go binary
COPY --from=go-builder /out/awg-api /awg-api

# Runtime state directories. The compose file persists both directories.
RUN mkdir -p /var/lib/postgresql/data /var/lib/awg-rest/bootstrap /etc/amnezia/rendered && \
    chown -R postgres:postgres /var/lib/postgresql && \
    chmod 700 /var/lib/awg-rest/bootstrap /etc/amnezia/rendered

COPY deploy/docker/all-in-one-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV PGDATA=/var/lib/postgresql/data
ENV AWG_STATE_DIR=/var/lib/awg-rest
ENV DATABASE_URL=postgres://postgres@127.0.0.1:5432/awg?sslmode=disable
ENV HTTP_ADDR=:18080
ENV JWT_ISSUER=awg-rest
ENV JWT_AUDIENCE=awg-control-plane
ENV JWT_ALLOWED_ALGS=HS256
ENV ENABLE_EMBEDDED_WORKER=true
ENV EMBEDDED_WORKER_EXEC=cli
ENV BOOTSTRAP_ENABLED=true
ENV BOOTSTRAP_CONF_DIR=/var/lib/awg-rest/bootstrap
ENV BOOTSTRAP_ENABLE_NAT=true
ENV BOOTSTRAP_EGRESS_IFACE=eth0
ENV LOG_LEVEL=info
ENV LOG_JSON=true
ENV WG_QUICK_USERSPACE_IMPLEMENTATION=amneziawg-go

# TUN device is required for userspace mode.
# Use: docker run --cap-add=NET_ADMIN --device=/dev/net/tun ...
EXPOSE 18080/tcp
EXPOSE 51820/udp
VOLUME ["/var/lib/postgresql/data", "/var/lib/awg-rest"]

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/awg-api"]
