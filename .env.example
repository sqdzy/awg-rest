# Production compose placeholders. Copy values into your deployment environment;
# do not commit real secrets.

JWT_ISSUER=https://idp.example.com/
JWT_AUDIENCE=awg-control-plane
JWT_ALLOWED_ALGS=RS256,ES256,EdDSA
LOG_LEVEL=info

AWG_INTERNAL_NETWORK=awg-backend-internal
AWG_UDP_PORT=51820

# Replace with published GHCR image names after the release workflow is added.
AWG_API_IMAGE=ghcr.io/YOUR_OWNER/awg-rest-api:v0.1.0
AWG_WORKER_IMAGE=ghcr.io/YOUR_OWNER/awg-rest-worker:v0.1.0
AWG_NODE_AGENT_IMAGE=ghcr.io/YOUR_OWNER/awg-rest-node-agent:v0.1.0
