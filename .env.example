# awg-rest all-in-one compose example.
# Copy to .env and change values for your server.

AWG_REST_IMAGE=ghcr.io/sqdzy/awg-rest-all-in-one:latest

# Public IP or DNS name used in generated client configs.
BOOTSTRAP_NODE_ENDPOINT=203.0.113.10

# Keep this long random value secret. Your backend uses the same value to sign
# HS256 JWTs for awg-rest.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=awg-rest
JWT_AUDIENCE=awg-control-plane
JWT_ALLOWED_ALGS=HS256

# Host bindings. The REST API is loopback-only by default; the VPN UDP port is
# public.
AWG_API_BIND=127.0.0.1:18080
AWG_UDP_BIND=51820
AWG_UDP_PORT=51820

# Initial tenant/profile/node created on the first run.
BOOTSTRAP_TENANT_SLUG=default
BOOTSTRAP_PROFILE_NAME=default-v2
BOOTSTRAP_POOL_CIDR=10.200.0.0/24
BOOTSTRAP_NODE_IFACE=awg0

# Container egress interface for NAT from VPN clients to the internet.
BOOTSTRAP_ENABLE_NAT=true
BOOTSTRAP_EGRESS_IFACE=eth0

# Network name to attach your backend container to.
AWG_INTERNAL_NETWORK=awg-backend-internal

LOG_LEVEL=info
